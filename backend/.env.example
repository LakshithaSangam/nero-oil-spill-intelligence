# ---- Runtime ----
ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://neuro:neuro@localhost:5432/neuro

# ---- Data Provider selection (unset -> "mock") ----
# imagery:      mock | hybrid | copernicus-dataspace | sentinel-hub | nasa-earthdata | usgs-earthexplorer
#               hybrid = scenario replay + real Copernicus Data Space scenes (keyless catalogue)
# incidents:    mock | hybrid | noaa   (hybrid = scenario catalog + real NOAA IncidentNews, keyless)
# oceanography: mock | copernicus-marine | open-meteo-marine   <- open-meteo needs NO key
# ais:          mock | global-fishing-watch | marine-cadastre
#               GFW needs AIS_API_KEY (globalfishingwatch.org/our-apis/tokens); marine-cadastre is keyless, US waters only
IMAGERY_PROVIDER=mock
INCIDENT_PROVIDER=mock
OCEANOGRAPHY_PROVIDER=mock
AIS_PROVIDER=mock

# Detection segmentation:
#   mock          deterministic scenario slick
#   classical-sar dark-spot detection on the real Sentinel-1 quicklook
#   trained-unet  a trained U-Net checkpoint (see backend/app/ml/README.md);
#                 also set SEGMENTATION_WEIGHTS. Needs `pip install -r requirements-ml.txt`.
# Non-mock models fall back to "mock" when they produce nothing.
# A per-run override (DetectionRequest.segmentation_model) picks the model without
# changing this default. A smoke checkpoint is committed at weights/oilspill_unet.pt
# (trained on synthetic tiles — retrain on the Zenodo dataset for production).
SEGMENTATION_MODEL=mock
SEGMENTATION_WEIGHTS=weights/oilspill_unet.pt

# ---- Real provider credentials ----
# Only needed when you switch a domain off "mock". See docs/DATA_INTEGRATION.md for
# step-by-step signup instructions for each service.

# Copernicus Data Space Ecosystem  (imagery: Sentinel-1 SAR / Sentinel-2)
# Catalogue SEARCH is keyless; a token is only needed to fetch scene pixels.
# Easiest: your CDSE account (register at https://dataspace.copernicus.eu/).
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Or, instead of the account, a registered OAuth client
# (https://dataspace.copernicus.eu/ -> User Settings -> OAuth clients):
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Sentinel Hub  (imagery: processed tiles / statistics)
# https://www.sentinel-hub.com/ -> Dashboard -> User settings -> OAuth clients
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# NASA Earthdata  (imagery: NASA/USGS archives)
# https://urs.earthdata.nasa.gov/ -> Generate Token
EARTHDATA_TOKEN=

# Copernicus Marine Service  (oceanography: currents / waves / SST, primary)
# https://marine.copernicus.eu/ -> Register
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Open-Meteo Marine  (oceanography fallback) needs NO credentials.
# Set OCEANOGRAPHY_PROVIDER=open-meteo-marine and it works immediately.

# AIS vendor  (vessel tracks) — e.g. Global Fishing Watch API token
# https://globalfishingwatch.org/our-apis/ -> request access
AIS_API_KEY=
